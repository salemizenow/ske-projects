// SKE Projects database (PostgreSQL). Run `npm run db:push` (dev) or create migrations with `npx prisma migrate dev`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum Access {
  MANAGE
  CONTRIBUTE
  VIEW
}

enum StepStatus {
  TODO
  IN_PROGRESS
  REVIEW
  CHANGES
  APPROVED
}

enum ProjectState {
  ACTIVE
  COMPLETED
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  phone        String?
  designation  String?
  passwordHash String
  role         Role            @default(MEMBER)
  canCreate    Boolean         @default(false)
  status       UserStatus      @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  owned        Project[]       @relation("ProjectOwner")
  memberships  ProjectMember[]
  steps        Step[]          @relation("StepAssignee")
  reviews      Step[]          @relation("StepReviewer")
  updates      StepUpdate[]
  activity     Activity[]
}

model Session {
  id        String   @id // sha256 of the cookie token; the token itself is never stored
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
}

model Project {
  id        String          @id @default(cuid())
  code      String          @unique // PRJ-1001, used in links
  title     String
  category  String
  client    String?
  site      String?
  workOrder String?
  start     DateTime
  due       DateTime
  budget    Int             @default(0)
  brief     String
  state     ProjectState    @default(ACTIVE)
  ownerId   String
  owner     User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  closedAt  DateTime?
  members   ProjectMember[]
  steps     Step[]
  documents Document[]
  activity  Activity[]

  @@index([ownerId])
}

model ProjectMember {
  projectId String
  userId    String
  access    Access
  addedAt   DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Step {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position       Int
  title          String
  assigneeId     String?
  assignee       User?        @relation("StepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status         StepStatus   @default(TODO)
  submittedAt    DateTime?
  reviewDecision String? // "approved" | "changes"
  reviewNote     String?
  reviewedAt     DateTime?
  reviewerId     String?
  reviewer       User?        @relation("StepReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  updates        StepUpdate[]

  @@index([projectId])
  @@index([assigneeId])
}

model StepUpdate {
  id        String     @id @default(cuid())
  stepId    String
  step      Step       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  pct       Int
  note      String
  createdAt DateTime   @default(now())
  files     Document[]

  @@index([stepId])
}

model Document {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepUpdateId String?
  stepUpdate   StepUpdate? @relation(fields: [stepUpdateId], references: [id], onDelete: SetNull)
  name         String
  size         Int
  contentType  String
  key          String?     // object key in S3; null when only the name was recorded
  uploadedById String
  createdAt    DateTime    @default(now())

  @@index([projectId])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  text      String
  kind      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}
